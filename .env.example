# Runtime
NODE_ENV=development
# Lock tooling to Node 22 locally (see .nvmrc / .node-version)

# Database — local / EC2 Docker Postgres (docker compose up -d)
DATABASE_URL="postgresql://invent:invent@localhost:5433/invent?schema=public"

# Auth.js (M3) — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# AUTH_URL="http://localhost:3000"
# On EC2 preview: AUTH_URL="http://15.206.84.172"

# Admin allowlist — ONLY these emails may hold ADMIN / access /admin
ADMIN_EMAILS=admin@iitbinvent.com

# AWS (ap-south-1 / Mumbai)
AWS_REGION=ap-south-1
# SES region (same as AWS_REGION unless SES is elsewhere)
SES_REGION=ap-south-1

# Transactional email via AWS SES (not Resend)
EMAIL_FROM=conference@iitbinvent.com
SES_FROM_EMAIL=conference@iitbinvent.com

# S3 uploads — budget cap 5 GB
# S3_BUCKET=invent-m1-uploads-221237747582
S3_BUCKET=
S3_UPLOAD_PREFIX=uploads/

# Site URL
# NEXT_PUBLIC_SITE_URL=http://15.206.84.172

# --- Optional later ---
# Amplify: invent-m1 / d3byxpkqpnux8m (GitHub not connected; not live runtime)
