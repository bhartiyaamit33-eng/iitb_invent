# Runtime
NODE_ENV=development
# Lock tooling to Node 22 locally (see .nvmrc / .node-version)
# nvm use / fnm use should pick this up automatically

# Database — local / EC2 Docker Postgres (docker compose up -d)
# Host port 5433 → container 5432
DATABASE_URL="postgresql://invent:invent@localhost:5433/invent?schema=public"

# Auth.js (unused until M3 — generate with: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# AUTH_URL="http://localhost:3000"
# On EC2 preview: AUTH_URL="http://15.206.84.172"
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_LINKEDIN_ID=
# AUTH_LINKEDIN_SECRET=

# AWS (ap-south-1 / Mumbai)
AWS_REGION=ap-south-1

# S3 uploads — budget cap 5 GB total (speaker photos, logos, QR exports)
# Provisioned bucket (optional until upload features land):
# S3_BUCKET=invent-m1-uploads-221237747582
S3_BUCKET=
S3_UPLOAD_PREFIX=uploads/

# SES transactional email (magic links, tickets, reminders)
SES_FROM_EMAIL=noreply@iitbinvent.com
# SES_CONFIGURATION_SET=

# Site URL
# Local: http://localhost:3000
# EC2 (no DNS cutover yet): http://15.206.84.172
# Production (still Cloudflare): https://iitbinvent.com
# NEXT_PUBLIC_SITE_URL=http://15.206.84.172

# --- Optional later ---
# Amplify Hosting app (created, GitHub not connected): invent-m1 / d3byxpkqpnux8m
# Default domain: https://main.d3byxpkqpnux8m.amplifyapp.com
# Do not point iitbinvent.com here until M2 landing pixel-match is accepted.
