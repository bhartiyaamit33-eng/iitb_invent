# Runtime
NODE_ENV=development
# Lock tooling to Node 22 locally (see .nvmrc / .node-version)

# Database — local / EC2 Docker Postgres (docker compose up -d)
DATABASE_URL="postgresql://invent:invent@localhost:5433/invent?schema=public"
# Destructive local reset requires a one-command explicit value:
# ALLOW_DESTRUCTIVE_SEED=RESET_LOCAL_DATA npm run db:seed
# Never store ALLOW_DESTRUCTIVE_SEED in an environment file or production.

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
# AUTH_URL="http://localhost:3000"
# Production: AUTH_URL="https://iitbinvent.com"

# OAuth (optional — buttons appear when set)
# Google Cloud Console → OAuth client (Web) → redirect: {AUTH_URL}/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# LinkedIn → Auth → OpenID Connect app → redirect: {AUTH_URL}/api/auth/callback/linkedin
# AUTH_LINKEDIN_ID=
# AUTH_LINKEDIN_SECRET=

# Optional: set when seeding to hash+store a new admin password (never commit the value)
# ADMIN_SEED_PASSWORD=

# Admin allowlist — ONLY these emails may hold ADMIN / access /admin
ADMIN_EMAILS=admin@iitbinvent.com

# AWS (ap-south-1 / Mumbai)
AWS_REGION=ap-south-1
# SES region (same as AWS_REGION unless SES is elsewhere)
SES_REGION=ap-south-1

# Transactional email via AWS SES (not Resend)
EMAIL_FROM=conference@iitbinvent.com
SES_FROM_EMAIL=conference@iitbinvent.com

# Or send through an SMTP relay instead of SES (used whenever SMTP_HOST is set),
# e.g. the IIT Bombay relay with an LDAP login. EMAIL_FROM must be an address
# that login may send as.
# SMTP_HOST=smtp-auth.iitb.ac.in
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM_NAME=IITB INV.ENT
# S3 uploads — budget cap 5 GB (speaker photos under uploads/speakers/)
S3_BUCKET=invent-m1-uploads-221237747582
S3_UPLOAD_PREFIX=uploads/

# Site URL (baked into client at build — must be public hostname, not an IP)
NEXT_PUBLIC_SITE_URL=https://iitbinvent.com

# Search / analytics (leave blank until the IDs exist)
# Google Analytics 4 measurement ID (G-XXXXXXXX)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools meta verification
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Conference registration fee is by professional category (not a single env):
# UG/PG/PhD students ₹5,000 · faculty/professors ₹10,000 · industry ₹20,000, GST inclusive.
# Amount + payment link are emailed only after organisers select paper, poster, or attendee.
#
# IIT Bombay OnlinePay. The LIVE gateway (https://portal.iitb.ac.in/onlinepay/) is
# the default. TEST app 10172 runs on the TEST host, which resolves on the IITB
# network only: use it from a campus server (e.g. the LAN copy) with
#   ONLINEPAY_GATEWAY_URL=https://newtestasc.iitb.ac.in/onlinepay_test/
# 10172 is refused on the LIVE host, where it could settle into another app.
# Register with ASC (payment request validation mandatory: Yes):
#   Validation URL:  https://iitbinvent.com/api/onlinepay/validate
#   Return URL (immediate + reconciliation):
#                    https://iitbinvent.com/api/onlinepay/payack
# No secret is needed: every notice is confirmed with ASC's ACK servlet.
ONLINEPAY_APP_ID=
# Echoed back on every transaction; keep it stable, ASC reports filter on it.
# ONLINEPAY_PURPOSE=IITB INV.ENT conference registration
# Gateway base URL ending in /: the TEST host above, or a local mock gateway.
# ONLINEPAY_GATEWAY_URL=http://127.0.0.1:8099/

# --- Optional later ---
# Amplify: invent-m1 / d3byxpkqpnux8m (GitHub not connected; not live runtime)
