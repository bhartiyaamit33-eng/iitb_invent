# Legacy Cloudflare Worker deploy (live on iitbinvent.com until Amplify DNS cutover).
# Primary development path is Next.js on Amplify — see root README.md.

{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "iitbinvent",
  "main": "index.js",
  "compatibility_date": "2026-05-03",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../public",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "iitbinvent.com", "custom_domain": true },
    { "pattern": "www.iitbinvent.com", "custom_domain": true }
  ]
}
