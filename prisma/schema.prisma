// INVENT platform — multi-year data model (PRD Section 5)
// Hosting target: AWS Amplify + RDS Postgres (ap-south-1)

generator client {
  provider      = "prisma-client-js"
  // native = local Mac/dev; rhel = Amazon Linux 2023 / EC2 standalone
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ATTENDEE
  SPEAKER
  VOLUNTEER
  REVIEWER
  ORGANISER
  ADMIN
}

enum EditionStatus {
  DRAFT
  ANNOUNCED
  REGISTRATION_OPEN
  LIVE
  ARCHIVED
}

enum SessionFormat {
  KEYNOTE
  PANEL
  RESEARCH_PAPER
  POSTER
  WORKSHOP
  PITCH
  VC_FORUM
  NETWORKING
  BREAK
}

enum RegStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

enum RsvpStatus {
  GOING
  WAITLISTED
  CANCELLED
}

enum PersonaType {
  STUDENT
  FACULTY
  FOUNDER
  INVESTOR
  OPERATOR
  RESEARCHER
  OTHER
}

enum VentureKind {
  STARTUP
  PROJECT
  IDEA
}

enum ProfessionalCategory {
  PHD_SCHOLAR
  POSTDOC
  PROFESSOR
  INDUSTRY
  OTHER
}

enum PhdYear {
  YEARS_1_3
  YEARS_4_5
  YEAR_6_PLUS
  THESIS_SUBMITTED
}

enum PostdocSeeking {
  YES
  NO
  MAYBE
}

enum ParticipationCategory {
  PAPER_ONLY
  PAPER_OR_POSTER
  POSTER_ONLY
  ATTENDEE
  OTHER
}

enum ApplicationStatus {
  RECEIVED
  SHORTLISTED_PAPER
  SHORTLISTED_POSTER
  ATTENDEE
  WAITLISTED
  REJECTED
  WITHDRAWN
}

enum ApplicationPaymentStatus {
  NOT_REQUIRED
  UNPAID
  REPORTED
  PAID
  WAIVED
}

enum ReviewAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum ReviewRecommendation {
  STRONG_ACCEPT
  ACCEPT
  WEAK_ACCEPT
  BORDERLINE
  WEAK_REJECT
  REJECT
}

// ─── Identity (edition-independent) ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String
  passwordHash  String? // null if they only ever use OAuth
  image         String?
  role          Role      @default(ATTENDEE)
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  profile       Profile?
  registrations Registration[]
  rsvps         Rsvp[]
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  ventures      Venture[]
  connectionRequestsFrom ConnectionRequest[] @relation("ConnectionFrom")
  connectionRequestsTo   ConnectionRequest[] @relation("ConnectionTo")
  conferenceApplications ConferenceApplication[]
  notifications          UserNotification[]
  assignedReviews        ApplicationReview[] @relation("ReviewReviewer")
  reviewAssignmentsMade  ApplicationReview[] @relation("ReviewAssigner")
}

model Profile {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  personaType  PersonaType?
  headline     String?
  organisation String?
  bio          String?      @db.Text
  city         String?
  phone        String?
  linkedinUrl  String?
  websiteUrl   String?
  twitterUrl   String?
  githubUrl    String?
  interests    String[]
  lookingFor   String[]
  directoryOptIn Boolean    @default(false)
  showEmail    Boolean      @default(false)
  completeness Int          @default(0)
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
}

/// Soft intro: we email the recipient (no CC). Requester contact stays in the body.
model ConnectionRequest {
  id        String   @id @default(cuid())
  fromUserId String
  toUserId   String
  fromUser   User     @relation("ConnectionFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("ConnectionTo", fields: [toUserId], references: [id], onDelete: Cascade)
  message   String   @db.Text
  editionId String?
  createdAt DateTime @default(now())

  @@index([toUserId, createdAt])
  @@index([fromUserId, createdAt])
}

// ─── Edition (year container) ─────────────────────────────────────────────────

model Edition {
  id        String @id @default(cuid())
  year      Int    @unique
  slug      String @unique
  name      String
  tagline   String?
  theme     String?
  startsAt  DateTime
  endsAt    DateTime
  venueName String
  venueAddress String
  venueLat  Float?
  venueLng  Float?
  timezone  String @default("Asia/Kolkata")

  status    EditionStatus @default(DRAFT)
  isCurrent Boolean       @default(false)

  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?

  /// LinkedIn connect note template — tokens: {firstName}, {senderName}, {senderHeadline}, {eventName}, {eventDateShort}, {sessionName}
  connectNoteTemplate String @default("Hi {firstName}, I'm {senderName}, attending IIT Bombay INVENT on {eventDateShort}. Nice to connect.")

  deletedAt DateTime?

  tracks        Track[]
  sessions      Session_[]
  speakers      Speaker[]
  sponsors      Sponsor[]
  registrations Registration[]
  pages         Page[]
  faqs          Faq[]
  stats         EditionStat[]
  notifySignups NotifySignup[]
  ventures      Venture[]
  conferenceApplications ConferenceApplication[]
}

/// IIT Bombay startups / projects / ideas — public directory listings.
model Venture {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  editionId   String?
  edition     Edition?    @relation(fields: [editionId], references: [id], onDelete: SetNull)
  kind        VentureKind
  name        String
  slug        String      @unique
  tagline     String?
  description String?     @db.Text
  websiteUrl  String?
  logoUrl     String?
  isPublished Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@index([kind, isPublished, deletedAt])
  @@index([userId])
  @@index([editionId])
}

// ─── Programme ────────────────────────────────────────────────────────────────

model Track {
  id          String    @id @default(cuid())
  editionId   String
  edition     Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?   @db.Text
  colour      String?
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  sessions    Session_[]

  @@unique([editionId, slug])
}

/// Named Session_ to avoid colliding with Auth.js Session
model Session_ {
  id           String        @id @default(cuid())
  editionId    String
  edition      Edition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  trackId      String?
  track        Track?        @relation(fields: [trackId], references: [id])
  title        String
  slug         String
  description  String?       @db.Text
  format       SessionFormat
  startsAt     DateTime
  endsAt       DateTime
  room         String?
  floor        String?
  capacity     Int?
  rsvpRequired Boolean       @default(false)
  waitlistOpen Boolean       @default(true)
  streamUrl    String?
  slidesUrl    String?
  recordingUrl String?
  isPublished  Boolean       @default(false)
  sortOrder    Int           @default(0)
  deletedAt    DateTime?

  speakers SessionSpeaker[]
  rsvps    Rsvp[]

  @@unique([editionId, slug])
  @@index([editionId, startsAt])
}

model Speaker {
  id           String    @id @default(cuid())
  editionId    String
  edition      Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  userId       String?
  name         String
  title        String?
  organisation String?
  bio          String?   @db.Text
  photoUrl     String?
  linkedinUrl  String?
  websiteUrl   String?
  isKeynote    Boolean   @default(false)
  isPublished  Boolean   @default(false)
  sortOrder    Int       @default(0)
  deletedAt    DateTime?
  sessions     SessionSpeaker[]
}

model SessionSpeaker {
  sessionId String
  speakerId String
  role      String?
  session   Session_ @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speaker   Speaker  @relation(fields: [speakerId], references: [id], onDelete: Cascade)

  @@id([sessionId, speakerId])
}

// ─── Registration & RSVP ─────────────────────────────────────────────────────

model Registration {
  id          String    @id @default(cuid())
  userId      String
  editionId   String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  edition     Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  status      RegStatus @default(CONFIRMED)
  ticketCode  String    @unique
  qrToken     String    @unique
  checkedInAt DateTime?
  checkedInBy String?
  source      String?
  answers     Json?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@unique([userId, editionId])
  @@index([editionId, status])
}

model Rsvp {
  id         String     @id @default(cuid())
  userId     String
  sessionId  String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  session    Session_   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status     RsvpStatus @default(GOING)
  position   Int?
  attendedAt DateTime?
  createdAt  DateTime   @default(now())
  deletedAt  DateTime?

  @@unique([userId, sessionId])
  @@index([sessionId, status])
}

// ─── CMS content ──────────────────────────────────────────────────────────────

model Page {
  id          String    @id @default(cuid())
  editionId   String
  edition     Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  body        String    @db.Text
  isPublished Boolean   @default(false)
  deletedAt   DateTime?

  @@unique([editionId, slug])
}

model Faq {
  id          String    @id @default(cuid())
  editionId   String
  edition     Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  question    String
  answer      String    @db.Text
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(true)
  deletedAt   DateTime?
}

model EditionStat {
  id        String  @id @default(cuid())
  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  label     String
  value     String
  sortOrder Int     @default(0)
}

model Sponsor {
  id         String    @id @default(cuid())
  editionId  String
  edition    Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  name       String
  logoUrl    String
  websiteUrl String?
  tier       String
  sortOrder  Int       @default(0)
  deletedAt  DateTime?
}

model NotifySignup {
  id        String   @id @default(cuid())
  email     String
  editionId String
  edition   Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  converted Boolean  @default(false)

  @@unique([email, editionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Auth.js (NextAuth v5) adapter tables ─────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Call for applications — research conference paper/poster/attendee.
model ConferenceApplication {
  id        String @id @default(cuid())
  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  email       String
  name        String
  phone       String
  institution String

  professionalCategory ProfessionalCategory
  professionalOther    String?
  phdYear              PhdYear?
  seekingPostdoc       PostdocSeeking?

  participationCategory ParticipationCategory
  participationOther   String?
  paperTitle           String?

  abstractFileName    String?
  abstractStorage     String?
  abstractStorageKey  String?

  sendCopy Boolean @default(false)
  status    ApplicationStatus @default(RECEIVED)
  adminNotes String? @db.Text

  /// Unguessable token so organisers can open/export the PDF without a session.
  abstractViewToken String @unique

  paymentStatus      ApplicationPaymentStatus @default(NOT_REQUIRED)
  paymentAmountPaise Int                     @default(500000)
  paymentToken       String                  @unique
  paymentRef         String?
  paidAt             DateTime?

  /// IIT Bombay Online Pay (sReqId / sUserId / transId from OP).
  opReqId    String? @unique
  opUserId   String?
  opTransId  String?
  opRefNo    String?
  opProvId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reviews   ApplicationReview[]

  @@unique([editionId, email])
  @@index([editionId, status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([opTransId])
  @@map("ColloquiumApplication")
}

/// One programme-committee review assignment for a colloquium submission.
model ApplicationReview {
  id            String                 @id @default(cuid())
  applicationId String
  application   ConferenceApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User                   @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  assignedById  String?
  assignedBy    User?                  @relation("ReviewAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  status               ReviewAssignmentStatus @default(ASSIGNED)
  expertise            Int?
  score                Int?
  recommendation       ReviewRecommendation?
  publicComments       String?                @db.Text
  confidentialComments String?                @db.Text
  dueAt                 DateTime?
  assignedAt            DateTime               @default(now())
  startedAt             DateTime?
  submittedAt           DateTime?
  updatedAt             DateTime               @updatedAt

  @@unique([applicationId, reviewerId])
  @@index([reviewerId, status])
  @@index([applicationId, status])
}

/// In-app inbox so applicants still see selection/payment when SES fails.
model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String    @db.Text
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

