# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*

# ── Build output ──────────────────────────────────────────────────────────────
/.next/
/.next-*/
/out/
/build/
dist/
*.tsbuildinfo
next-env.d.ts
invent-next-tmp/
.vercel
.wrangler/
.dev.vars

# ── Secrets: never commit ─────────────────────────────────────────────────────
# Environment files. Only the template is tracked.
.env
.env.*
!.env.example
# Private keys and certificates (e.g. the SSH key kept in the project folder).
/raj-invent
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
# Server-local Compose overrides (database password).
docker-compose.override.yml

# ── Local data ────────────────────────────────────────────────────────────────
# Uploaded abstracts when S3 is not configured.
/data/
# Database dumps (never commit real data).
backups/
*.dump
*.sql.gz
/prisma/*.db
/prisma/*.db-journal

# ── Tests and tooling ─────────────────────────────────────────────────────────
coverage/
test-results/
playwright-report/
# Reticle: generated landing SDK bundle (rebuild with esbuild)
.reticle/landing-sdk.js

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── OS and editors ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
